{
  "name": "devcon-1/tessl-carnival",
  "dependencies": {},
  "actions": {
    "implement": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl-labs/factory#implement-github-issue",
      "concurrency": {
        "keys": [
          {
            "key": "implement:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      },
      "environment": "factory-devcon-1-tessl-carnival-implement",
      "instructions": "After npm run check passes, if your change can alter what the carnival shows, capture it: run scripts/screenshot.sh .screenshots, commit only that folder and push, and note the commit with git rev-parse HEAD. Then run git rm -r .screenshots, commit and push, so the final diff has no screenshots. In the pull request body, under a ## Screenshots heading, show each picture as ![name](https://raw.githubusercontent.com/<owner>/<repo>/<that commit>/.screenshots/<name>.png). Skip all of this when nothing visible changed. If the script fails, say so in one sentence in the pull request and carry on: a screenshot problem never holds up the change."
    },
    "shepherd": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-opus-5-5",
      "skill": "tessl-labs/factory#shepherd",
      "concurrency": {
        "keys": [
          {
            "key": "github:pr:{{ inputs.GITHUB_PR_NUMBER }}",
            "limit": 1
          }
        ],
        "debounce": "90s"
      },
      "environment": "factory-devcon-1-tessl-carnival-shepherd",
      "instructions": "After npm run check passes, if your change can alter what the carnival shows, capture it: run scripts/screenshot.sh .screenshots, commit only that folder and push, and note the commit with git rev-parse HEAD. Then run git rm -r .screenshots, commit and push, so the final diff has no screenshots. Show each new picture in your reply on the pull request, as ![name](https://raw.githubusercontent.com/<owner>/<repo>/<that commit>/.screenshots/<name>.png). Skip all of this when your fix changes nothing visible. If the script fails, say so in one sentence and carry on: a screenshot problem never holds up a fix."
    },
    "follow-ticket-changes": {
      "tags": [
        "Ticket to PR"
      ],
      "agent": "claude",
      "model": "claude-haiku-4-5",
      "skill": "tessl-labs/factory#follow-ticket-changes",
      "environment": "factory-devcon-1-tessl-carnival-follow-ticket-changes"
    }
  },
  "triggers": {
    "implement": {
      "on": [
        "github:issues.labeled"
      ],
      "when": {
        "event.label.name": "tessl"
      },
      "action": {
        "use": "implement",
        "inputs": {
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      }
    },
    "shepherd-pr-review": {
      "on": [
        "github:pull_request_review.submitted"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            619968
          ]
        },
        "event.pull_request.state": "open",
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1443188711,
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}"
        }
      }
    },
    "shepherd-pr-review-comment": {
      "on": [
        "github:pull_request_review_comment.created"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            619968
          ]
        },
        "event.pull_request.state": "open",
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1443188711,
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}"
        }
      }
    },
    "shepherd-pr-comment": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "true",
        "event.sender.id": {
          "in": [
            619968
          ]
        },
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "shepherd",
        "inputs": {
          "GITHUB_PR_NUMBER": "{{ event.issue.number }}"
        }
      }
    },
    "follow-ticket-changes-issue-unlabelled": {
      "on": [
        "github:issues.unlabeled"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            619968
          ]
        },
        "event.label.name": "tessl"
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "taken-back",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "follow-ticket-changes-issue-closed": {
      "on": [
        "github:issues.closed"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            619968
          ]
        },
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "issue-ended",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "follow-ticket-changes-issue-replied": {
      "on": [
        "github:issue_comment.created"
      ],
      "when": {
        "isPullRequest": "false",
        "event.sender.id": {
          "in": [
            619968
          ]
        },
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "replied",
          "GITHUB_ISSUE_LABEL": "tessl",
          "GITHUB_ISSUE_NUMBER": "{{ event.issue.number }}"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:github-issue:{{ inputs.GITHUB_ISSUE_NUMBER }}",
            "limit": 1
          }
        ]
      }
    },
    "follow-ticket-changes-pr-closed": {
      "on": [
        "github:pull_request.closed"
      ],
      "when": {
        "event.sender.id": {
          "in": [
            619968
          ]
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        }
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "pr-closed",
          "GITHUB_PR_NUMBER": "{{ event.pull_request.number }}",
          "GITHUB_ISSUE_LABEL": "tessl"
        }
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:github-pr:{{ inputs.GITHUB_PR_NUMBER }}",
            "limit": 1
          }
        ]
      }
    }
  },
  "schedules": {
    "doc-gardening": {
      "cron": "0 6 * * 1",
      "description": "Weekly check for docs and agent instructions that no longer match the code",
      "action": {
        "skill": "file:tessl-factory#doc-gardening",
        "environment": "tessl-carnival-loops",
        "agent": "claude-code",
        "model": "claude-sonnet-5-5"
      }
    }
  }
}
